# Copy to .env. Names only here — never commit values.

# Artificial Analysis data API (free, 1 000 requests/day): https://artificialanalysis.ai/documentation
ARTIFICIAL_ANALYSIS_API_KEY=

# Bearer tokens for the API and MCP: name:scope,scope:secret;name:scope:secret
# scopes: read profiles:write apply telemetry
SIEVE_TOKENS=

# Optional bearer for an OpenAI-compatible gateway listed in sieve.toml [inventories.*]
GATEWAY_TOKEN=

# Token the MCP server presents to the API
SIEVE_TOKEN=
