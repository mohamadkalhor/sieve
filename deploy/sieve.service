[Unit]
Description=Sieve — weighted model selection
Documentation=https://github.com/mohamadkalhor/sieve
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Keys live here, not in sieve.toml. The leading `-` means the unit still
# starts when the file is absent: OpenRouter needs no key.
EnvironmentFile=-/etc/default/sieve
WorkingDirectory=/opt/sieve
# `--no-server-header`: the version of the server we run is nobody's business
# but ours, and gate's unit already starts this way.
ExecStart=/opt/sieve/.venv/bin/uvicorn sieve.api.app:app --host 127.0.0.1 --port 8111 --no-server-header
Restart=on-failure
RestartSec=5

User=sieve
Group=sieve
StateDirectory=sieve

# It reads public APIs and writes one SQLite file. Nothing else is needed.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/opt/sieve/data /opt/sieve/out /opt/sieve/profiles

# The box has 4 GB. 400M was set when a ranking was a scan of the observation
# table and the service sat at 142 MiB; once several of those overlapped, the
# cap was reached, the process swapped, and everything stopped answering for
# twenty-two minutes. The scan is gone and the built views are bounded, so this
# is headroom for a run and a few requests at once, not a licence to grow.
MemoryMax=1G
TasksMax=64

[Install]
WantedBy=multi-user.target
