# Copy to sieve.toml. Values here are examples; nothing secret ever lives in
# this file -- a source names the environment variable that holds its key.

[store]
path = "data/sieve.db"

[server]
host = "127.0.0.1"
port = 8110
cors = []            # e.g. ["http://localhost:5173"] while developing the web app
read_token = false   # true makes reads need a token with the `read` scope
web = "web/build"    # served at / when the directory exists

[paths]
axes = "data/axes"
profiles = "profiles"
aliases = "data/aliases.yaml"
out = "out"

# --- sources ---------------------------------------------------------------

[sources.aa_llm]
enabled = true
key_env = "ARTIFICIAL_ANALYSIS_API_KEY"
modalities = ["llm"]

[sources.aa_media]
enabled = true
key_env = "ARTIFICIAL_ANALYSIS_API_KEY"
modalities = [
  "text-to-image",
  "image-editing",
  "text-to-video",
  "image-to-video",
  "text-to-speech",
  # the free tier below adds these three
  "music",
  "speech-to-text",
  "speech-to-speech",
]

# The free tier, one flag per endpoint, read as source options. Each endpoint is
# its own leaderboard: music is two separate votes (a model can be good at
# instrumental and ordinary with vocals), speech-to-text publishes a word error
# rate rounded to one decimal, and speech-to-speech publishes three scores with
# very different coverage.
#
# text-to-speech is deliberately absent. The documented arena endpoint serves it,
# and running both wrote two rows for one measurement.
free_music_instrumental = true
free_music_with_vocals = true
free_speech_to_text = true
free_speech_to_speech = true

[sources.openrouter]
enabled = true       # no key needed
modalities = ["llm"]

# Price for the media field. Artificial Analysis measures media quality and
# publishes no media price at all, so cost for image, video and speech comes
# from here or from nowhere. No key needed.
# Artificial Analysis prices media on its LEADERBOARDS, though not on the v2
# data API. Same uuid as the score, so the price lands on the model that was
# measured with no name matching -- which is why this is the primary media price
# source and the marketplaces below are the fallback.
#
# It reads a page rather than a documented endpoint, so it fails loudly: a board
# whose shape has moved turns the run red, and `sieve check` errors on an
# enabled board that has priced nothing while its siblings have.
[sources.aa_media_prices]
enabled = true
modalities = [
  "text-to-image",
  "image-editing",
  "text-to-video",
  "image-to-video",
  "text-to-speech",
  "speech-to-text",
  "speech-to-speech",
]

# fal and deepinfra are the FALLBACK now, not the source, and they ship OFF.
#
# Artificial Analysis prices the same models on the same row as the score, so a
# marketplace price is only wanted where AA has none -- music, whose board
# carries no price at all, and the models that do not join the catalogue.
#
# Nothing is deleted: the code, the tests and the recordings all stay, and
# turning either back on is one word. Two sources pricing one model is fine and
# expected -- both rows are kept and `sieve check` notes any pair more than 3x
# apart.
[sources.fal]
enabled = false
modalities = [
  "text-to-image",
  "image-editing",
  "text-to-video",
  "image-to-video",
  "text-to-speech",
  "speech-to-text",
  # fal files music and sound effects together under `text-to-audio`, so a
  # row is only claimed as music when Artificial Analysis -- which scores
  # music and never scores sound effects -- already knows the id.
  "music",
]

# deepinfra: the second price source for media, and a complementary one -- it
# hosts models fal has no price sentence for at all. No key, one request, and
# every rate machine-readable.
#
# Its `text-to-image` spans our text-to-image and image-editing, and its
# `text-to-video` spans text-to-video and image-to-video, so a row in either is
# offered under both and kept only where Artificial Analysis already knows the
# id in that modality.
#
# fal and deepinfra host some of the same models at different rates. Both prices
# are kept -- a price is one vendor charging to run one model -- and
# `sieve check` notes any model the two disagree about by more than 3x.
[sources.deepinfra]
enabled = false
modalities = [
  "text-to-image",
  "image-editing",
  "text-to-video",
  "image-to-video",
  "text-to-speech",
  "speech-to-text",
  "music",
]

# LMArena: human preference Elo, the one measurement no benchmark makes.
# CC-BY-4.0 -- see docs/sources.md for the attribution that licence requires.
#
# OFF BY DEFAULT, and it should stay off in CI. It is a bulk read of somebody
# else's dataset over ~10 requests, and it has no business running on every
# push. The `cache` directory holds the dataset's commit sha, so a pull that
# finds nothing changed makes one request and stops.
#
# `categories = true` pulls every sub-leaderboard as well: 10,517 rows for
# text against the 399 that are the leaderboard proper.
[sources.arena]
enabled = false
modalities = ["llm", "text-to-image", "image-editing", "text-to-video", "image-to-video"]
cache = "data/cache"
categories = false

[sources.manual]
enabled = true
dir = "data/observations"

# --- inventory: the models you can actually reach ---------------------------

[inventories.gateway]
kind = "openai_compat"
base_url = "http://localhost:20128"
token_env = "GATEWAY_TOKEN"

[inventories.pinned]
kind = "list"
models = ["anthropic/claude-sonnet-5"]

# --- targets: where chains go ----------------------------------------------

[targets.out]
kind = "file"
dir = "out"

[schedule]
pull = "hourly"
evaluate = "hourly"
